<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security configuration for 4KitchenBoard.

    Android 9+ (API 28+) blocks unencrypted HTTP traffic by default.
    The KitchenBoard backend runs on the home LAN (e.g. http://192.168.x.x/...)
    without TLS – a typical home-server setup where configuring HTTPS is
    impractical.  Allowing cleartext traffic is safe here because the app is
    designed exclusively for a trusted private network, and all external
    internet traffic (e.g. GitHub API calls for auto-updates) already uses
    HTTPS enforced by the remote server.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
