<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/panel_padding"
    android:paddingEnd="@dimen/panel_padding"
    android:paddingTop="@dimen/spacing_normal"
    android:paddingBottom="@dimen/spacing_small">

    <!-- Person name header -->
    <TextView
        android:id="@+id/tv_weight_chart_person"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/subtitle_text_size"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:paddingBottom="@dimen/spacing_small"/>

    <!-- Height input row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_small">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/weight_height_label"
            android:textSize="@dimen/body_text_size"
            android:textColor="@color/text_primary"/>

        <EditText
            android:id="@+id/et_height_cm"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="@string/weight_height_hint"
            android:background="@drawable/bg_input"
            android:padding="8dp"
            android:textSize="@dimen/body_text_size"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weight_unit_cm"
            android:textColor="@color/text_secondary"
            android:paddingStart="4dp"
            android:textSize="@dimen/body_text_size"/>

        <Button
            android:id="@+id/btn_save_height"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weight_save_height"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- Weight chart -->
    <com.kitchenboard.calendar.WeightChartView
        android:id="@+id/weight_chart_view"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="@dimen/spacing_normal"/>

    <!-- Legend -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/spacing_small">

        <View
            android:layout_width="24dp"
            android:layout_height="3dp"
            android:layout_gravity="center_vertical"
            android:background="#1E88E5"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/weight_legend_actual"
            android:textSize="@dimen/small_text_size"
            android:textColor="@color/text_secondary"/>

        <View
            android:layout_width="24dp"
            android:layout_height="3dp"
            android:layout_gravity="center_vertical"
            android:background="#FF9800"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/weight_legend_trend"
            android:textSize="@dimen/small_text_size"
            android:textColor="@color/text_secondary"/>

        <View
            android:layout_width="24dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical"
            android:background="#2843A047"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/weight_legend_healthy"
            android:textSize="@dimen/small_text_size"
            android:textColor="@color/text_secondary"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_normal"/>

    <!-- Add entry row -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/weight_add_entry_title"
        android:textSize="@dimen/small_text_size"
        android:textColor="@color/text_secondary"
        android:paddingBottom="@dimen/spacing_small"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_weight_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/weight_date_hint"
            android:inputType="none"
            android:focusable="false"
            android:background="@drawable/bg_input"
            android:padding="8dp"
            android:textSize="@dimen/body_text_size"/>

        <EditText
            android:id="@+id/et_weight_kg"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:hint="@string/weight_kg_hint"
            android:inputType="numberDecimal"
            android:background="@drawable/bg_input"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:textSize="@dimen/body_text_size"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weight_unit_kg"
            android:textColor="@color/text_secondary"
            android:paddingStart="4dp"
            android:textSize="@dimen/body_text_size"/>

        <Button
            android:id="@+id/btn_add_weight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weight_add_button"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- Weight entries list -->
    <LinearLayout
        android:id="@+id/ll_weight_entries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/spacing_normal"/>

</LinearLayout>
