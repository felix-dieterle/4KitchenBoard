<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/panel_padding"
    android:paddingEnd="@dimen/spacing_small">

    <!-- Person photo or color dot -->
    <ImageView
        android:id="@+id/view_person_dot"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="8dp"
        android:scaleType="centerCrop"
        android:visibility="invisible"
        android:contentDescription="@string/calendar_person_photo_desc"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_appointment_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_appointment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/body_text_size"
            android:textColor="@color/text_primary"/>

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_series_indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="4dp"
        android:src="@android:drawable/ic_popup_sync"
        android:contentDescription="@string/calendar_series_indicator"
        android:visibility="gone"/>

    <ImageButton
        android:id="@+id/btn_timer_appointment"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_recent_history"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/calendar_timer_button_desc"
        android:padding="10dp"/>

    <ImageButton
        android:id="@+id/btn_delete_appointment"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete_item"
        android:padding="8dp"/>

</LinearLayout>
