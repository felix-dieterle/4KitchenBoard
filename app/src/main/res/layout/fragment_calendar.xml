<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape split: CalendarView on the left, appointments on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/background">

    <!-- ── Left panel: Calendar ──────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="5"
        android:orientation="vertical"
        android:background="@color/panel_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calendar_title"
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold"
            android:textColor="@color/module_calendar"
            android:background="@color/module_calendar_light"
            android:paddingStart="@dimen/panel_padding"
            android:paddingEnd="@dimen/panel_padding"
            android:paddingTop="@dimen/spacing_normal"
            android:paddingBottom="@dimen/spacing_normal"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

        <!-- View-mode selector: 3 / 5 / 7 days or full month -->
        <LinearLayout
            android:id="@+id/ll_mode_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/panel_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/btn_mode_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calendar_mode_3days"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:padding="6dp"/>

            <Button
                android:id="@+id/btn_mode_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calendar_mode_5days"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:padding="6dp"/>

            <Button
                android:id="@+id/btn_mode_7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calendar_mode_7days"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:padding="6dp"/>

            <Button
                android:id="@+id/btn_mode_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calendar_mode_month"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:padding="6dp"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

        <!-- Week navigation row (visible only in 3/5/7-day mode) -->
        <LinearLayout
            android:id="@+id/ll_week_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/panel_bg"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btn_prev_week"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/calendar_prev_week"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/tv_week_range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>

            <ImageButton
                android:id="@+id/btn_next_week"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_media_next"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/calendar_next_week"
                android:padding="8dp"/>

        </LinearLayout>

        <!-- Day strip (visible in 3/5/7-day mode) -->
        <LinearLayout
            android:id="@+id/ll_day_strip"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"/>

        <!-- Full-month CalendarView (hidden by default, shown in month mode) -->
        <CalendarView
            android:id="@+id/calendar_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Vertical divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider"/>

    <!-- ── Right panel: Appointments ─────────────────────────────────────── -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header: selected date + manage templates + manage persons buttons -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/module_calendar_light"
                android:paddingStart="@dimen/panel_padding"
                android:paddingEnd="@dimen/panel_padding"
                android:paddingTop="@dimen/spacing_normal"
                android:paddingBottom="@dimen/spacing_normal">

                <TextView
                    android:id="@+id/tv_selected_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:textSize="@dimen/subtitle_text_size"
                    android:textStyle="bold"
                    android:textColor="@color/module_calendar"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <!-- Sync status indicator -->
                    <TextView
                        android:id="@+id/tv_calendar_sync_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:paddingEnd="8dp"
                        android:textSize="11sp"
                        android:visibility="gone"/>

                    <ImageButton
                        android:id="@+id/btn_feature_request"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@android:drawable/ic_btn_speak_now"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:contentDescription="@string/feature_request_hint"/>

                    <ImageButton
                        android:id="@+id/btn_manage_persons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:contentDescription="@string/calendar_manage_persons"/>

                    <ImageButton
                        android:id="@+id/btn_manage_templates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@android:drawable/ic_menu_manage"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:contentDescription="@string/calendar_manage_templates"/>

                    <ImageButton
                        android:id="@+id/btn_rotation_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_rotation"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:contentDescription="@string/rotation_toggle_hint"/>

                </LinearLayout>

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"/>

            <!-- Person / group quick-filter bar -->
            <HorizontalScrollView
                android:id="@+id/hsv_person_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel_bg"
                android:paddingStart="@dimen/panel_padding"
                android:paddingEnd="@dimen/panel_padding"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_person_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>

            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"/>

            <!-- Standard-template quick-add row (always visible) -->
            <HorizontalScrollView
                android:id="@+id/hsv_templates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/background"
                android:paddingStart="@dimen/panel_padding"
                android:paddingEnd="@dimen/panel_padding"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_template_buttons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>

            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"/>

            <!-- Empty state -->
            <TextView
                android:id="@+id/tv_appointments_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/calendar_no_appointments"
                android:textSize="@dimen/body_text_size"
                android:textColor="@color/text_secondary"
                android:visibility="gone"/>

            <!-- Appointment list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_appointments"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="72dp"/>

        </LinearLayout>

        <!-- FAB: Add new appointment -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_appointment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/calendar_add_appointment"
            app:srcCompat="@android:drawable/ic_input_add"
            android:src="@android:drawable/ic_input_add"/>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</LinearLayout>
