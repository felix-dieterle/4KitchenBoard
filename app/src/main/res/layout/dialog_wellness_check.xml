<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel_bg">

    <!-- ── Colored header bar ─────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:background="@color/accent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌅"
            android:textSize="24sp"
            android:paddingEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wellness_dialog_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/wc_btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- ── ViewFlipper: 3 pages ───────────────────────────────────────── -->
    <ViewFlipper
        android:id="@+id/wc_view_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- PAGE 0: Ratings ─────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/wc_page_ratings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/wc_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wellness_greeting"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wellness_subtitle"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:paddingBottom="16dp" />

            <!-- Müdigkeit row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wellness_tiredness"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/wc_rating_tiredness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!-- Gesundheit row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wellness_health"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/wc_rating_health"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!-- Stimmung row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wellness_mood"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/wc_rating_mood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <Button
                android:id="@+id/wc_btn_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wellness_next"
                android:backgroundTint="@color/accent"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

        </LinearLayout>

        <!-- PAGE 1: Person selection ─────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/wc_page_person"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wellness_person_question"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:paddingBottom="16dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/wc_person_grid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center" />

            </HorizontalScrollView>

            <TextView
                android:id="@+id/wc_no_persons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wellness_no_persons"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:visibility="gone"
                android:paddingBottom="16dp" />

            <Button
                android:id="@+id/wc_btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wellness_save"
                android:backgroundTint="@color/accent"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

        </LinearLayout>

        <!-- PAGE 2: Done ─────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/wc_page_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅"
                android:textSize="48sp"
                android:gravity="center"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/wc_done_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wellness_more_question"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/wc_btn_more"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/wellness_btn_more"
                    android:backgroundTint="@color/accent"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/wc_btn_done"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/wellness_btn_done"
                    android:backgroundTint="@color/text_secondary"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

    </ViewFlipper>

</LinearLayout>
