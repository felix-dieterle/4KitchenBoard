<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Subtle page-indicator dots (bottom-center, very unobtrusive) -->
    <LinearLayout
        android:id="@+id/dot_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:padding="6dp"
        android:layout_marginBottom="2dp"/>

    <!-- Version/build overlay shown briefly at startup -->
    <TextView
        android:id="@+id/version_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="10dp"
        android:textSize="11sp"
        android:textColor="#FFFFFFFF"
        android:background="#99000000"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:fontFamily="sans-serif"
        android:visibility="visible"/>

    <!-- Global account / sync setup button (bottom-start corner) -->
    <ImageButton
        android:id="@+id/btn_account_setup"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_preferences"
        android:contentDescription="@string/account_setup_title"
        android:alpha="0.45"/>

    <!-- Active profile avatar button (top-start corner) -->
    <FrameLayout
        android:id="@+id/fl_active_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp">

        <ImageView
            android:id="@+id/iv_active_profile"
            android:layout_width="@dimen/active_profile_avatar_size"
            android:layout_height="@dimen/active_profile_avatar_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_active_profile_empty"
            android:contentDescription="@string/active_profile_desc"
            android:alpha="0.55"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

    <!-- Dark phase toggle button (top-end, left of chat button) -->
    <ImageButton
        android:id="@+id/btn_dark_phase_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="92dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_active_phase"
        android:contentDescription="@string/dark_phase_toggle_desc"
        android:alpha="0.45"/>

    <!-- Chat button with unread-count badge (top-end, left of notification bell) -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="50dp">

        <ImageButton
            android:id="@+id/btn_chat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chat"
            android:contentDescription="@string/chat_title"
            android:alpha="0.45"/>

        <TextView
            android:id="@+id/tv_chat_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_notification_badge"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:minWidth="14dp"
            android:gravity="center"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- Global notification bell with unread-count badge (top-end corner) -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp">

        <ImageButton
            android:id="@+id/btn_notification_bell"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_notification_bell"
            android:contentDescription="@string/notifications_title"
            android:alpha="0.55"/>

        <TextView
            android:id="@+id/tv_notification_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_notification_badge"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:minWidth="14dp"
            android:gravity="center"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- Notification panel overlay (hidden until bell is tapped) -->
    <FrameLayout
        android:id="@+id/notification_panel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/notification_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:background="@color/panel_bg"
            android:elevation="8dp">

            <!-- Panel header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@color/accent"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/notifications_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_notifications_clear_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notifications_clear_all"
                    android:textColor="#FFFFFFBB"
                    android:textSize="13sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <ImageButton
                    android:id="@+id/btn_close_notification_panel"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="@string/close"
                    android:tint="#FFFFFF"/>
            </LinearLayout>

            <!-- Notification list (scrollable, constrained to ~45% screen height) -->
            <ScrollView
                android:id="@+id/notification_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/notification_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="@android:drawable/divider_horizontal_bright"
                    android:showDividers="middle"/>
            </ScrollView>

            <!-- Empty state (shown when list is empty) -->
            <TextView
                android:id="@+id/tv_no_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notifications_empty"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone"/>
        </LinearLayout>
    </FrameLayout>
    <!-- Chat panel overlay (hidden until chat button is tapped) -->
    <FrameLayout
        android:id="@+id/chat_panel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/chat_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:background="@color/panel_bg"
            android:elevation="8dp">

            <!-- Chat panel header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@color/accent"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/chat_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <!-- Active-status toggle: green dot = active, grey = inactive -->
                <ImageView
                    android:id="@+id/iv_chat_active_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_online_dot"
                    android:contentDescription="@string/chat_active_you"/>

                <TextView
                    android:id="@+id/tv_chat_active_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_active_you"
                    android:textColor="@color/chat_panel_label_dim"
                    android:textSize="12sp"
                    android:paddingEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageButton
                    android:id="@+id/btn_close_chat_panel"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="@string/close"
                    android:tint="#FFFFFF"/>
            </LinearLayout>

            <!-- Active peers row (visible when LAN mode is on and peers are found) -->
            <LinearLayout
                android:id="@+id/chat_active_peers_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@color/accent_light"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_online_dot"
                    android:contentDescription=""/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_active_users_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/tv_chat_active_peers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <!-- Message list (scrollable, ~40% screen height) -->
            <ScrollView
                android:id="@+id/chat_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/chat_message_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="@android:drawable/divider_horizontal_bright"
                    android:showDividers="middle"/>
            </ScrollView>

            <!-- Empty state -->
            <TextView
                android:id="@+id/tv_chat_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_empty"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone"/>

            <!-- Recipient selector row -->
            <LinearLayout
                android:id="@+id/chat_recipient_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="2dp"
                android:background="@color/panel_bg"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_recipient_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tv_chat_recipient_selected"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/chat_recipient_all"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>

            </LinearLayout>

            <!-- Send message row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@color/panel_bg"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/et_chat_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/chat_input_hint"
                    android:textSize="14sp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:maxLines="3"
                    android:inputType="textMultiLine|textCapSentences"/>

                <ImageButton
                    android:id="@+id/btn_chat_send"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_send"
                    android:contentDescription="@string/chat_send"
                    android:tint="@color/accent"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Central unread-notifications popup (appears over content when new notifications arrive) -->
    <FrameLayout
        android:id="@+id/unread_popup_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/unread_popup_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:orientation="vertical"
            android:background="@color/panel_bg"
            android:elevation="16dp">

            <!-- Popup header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@color/accent"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/unread_popup_title"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Scrollable notification list (max ~40% screen height) -->
            <ScrollView
                android:id="@+id/unread_popup_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/unread_popup_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="@android:drawable/divider_horizontal_bright"
                    android:showDividers="middle"/>
            </ScrollView>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="end">

                <TextView
                    android:id="@+id/btn_unread_popup_mark_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unread_popup_mark_all"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <TextView
                    android:id="@+id/btn_unread_popup_later"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unread_popup_later"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>