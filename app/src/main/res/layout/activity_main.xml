<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Subtle page-indicator dots (bottom-center, very unobtrusive) -->
    <LinearLayout
        android:id="@+id/dot_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:padding="6dp"
        android:layout_marginBottom="2dp"/>

    <!-- Version/build overlay shown briefly at startup -->
    <TextView
        android:id="@+id/version_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="10dp"
        android:textSize="11sp"
        android:textColor="#80FFFFFF"
        android:fontFamily="sans-serif"
        android:visibility="visible"/>

    <!-- Global account / sync setup button (bottom-start corner) -->
    <ImageButton
        android:id="@+id/btn_account_setup"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_preferences"
        android:contentDescription="@string/account_setup_title"
        android:alpha="0.45"/>

</FrameLayout>
