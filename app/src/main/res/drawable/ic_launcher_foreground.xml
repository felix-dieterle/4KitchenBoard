<?xml version="1.0" encoding="utf-8"?>
<!-- Fork (left) + Knife (right): universal kitchen symbol for the 4KitchenBoard launcher icon.
     Designed for the adaptive-icon safe zone (108×108 dp, safe area 18–90 dp on each axis).
     fillType="evenOdd" cuts the gaps between fork tines (requires API 24+, fine for the
     adaptive-icon foreground which already needs API 26). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fork – centered at x=38, spanning the full safe-zone height (y=26–85) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M27,26 L49,26 L49,52 L43,58 L43,82 Q43,86 38,86 Q33,86 33,82 L33,58 L27,52 Z
            M33,26 L35,26 L35,52 L33,52 Z
            M41,26 L43,26 L43,52 L41,52 Z" />

    <!-- Knife – centered at x=70, spanning the full safe-zone height (y=26–85) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M70,26 Q78,32 78,44 L78,52 L74,52 L74,82 Q74,86 70,86 Q66,86 66,82 L66,52 L62,52 Q62,38 70,26 Z" />

</vector>
